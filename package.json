{
  "name": "jianli-app",
  "version": "26.9.29-rc.1",
  "main": "dist-electron/main/index.js",
  "description": "工作时强制休息，保护眼睛，守护健康！",
  "author": "JadeQiu <xxx@xxx.com>",
  "license": "MIT",
  "private": true,
  "keywords": [
    "electron",
    "rollup",
    "vite",
    "vue3",
    "vue",
    "健康"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "debug": {
    "env": {
      "VITE_DEV_SERVER_URL": "http://127.0.0.1:3344/"
    }
  },
  "type": "module",
  "scripts": {
    "prestart": "node check-node-version.js",
    "release-old": "npm run prestart && standard-version",
    "release": "npm run update-changelog && node generate-version.js",
    "update-changelog": "node update-changelog.js",
    "q": "npm run prestart && npm run debug && npm run dev",
    "dev": "chcp 65001 && npm run prestart && vite",
    "debug": "npm run prestart && bash ./node_modules/.bin/vue-devtools",
    "build": "set NODE_OPTIONS=--max-old-space-size=10240&& npm run prestart && vue-tsc --noEmit && vite build &&  electron-builder",
    "preview": "npm run prestart && vite preview",
    "fetch-electron": "node scripts/fetch-electron.cjs"
  },
  "devDependencies": {
    "@dagrejs/dagre": "^1.1.8",
    "@lucide/vue": "^1.21.0",
    "@originjs/vite-plugin-commonjs": "^1.0.3",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^24.19.0",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vitejs/plugin-vue-jsx": "^5.1.1",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/core": "^1.47.0",
    "@vue-flow/node-resizer": "^1.5.0",
    "@vue-flow/node-toolbar": "^1.1.1",
    "@vue/devtools": "^7.7.2",
    "@vueup/vue-quill": "^1.5.5",
    "auto-launch": "^5.0.6",
    "axios": "^1.8.1",
    "clipboard-event": "^1.6.0",
    "colors": "^1.4.0",
    "cron": "^4.3.0",
    "diff": "^9.0.0",
    "echarts": "^5.5.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.17.0",
    "electron-devtools-installer": "^4.0.0",
    "electron-store": "^11.0.2",
    "element-plus": "^2.9.8",
    "epubjs": "^0.3.93",
    "fast-glob": "^3.3.3",
    "globby": "^15.0.0",
    "json-editor-vue": "^0.18.1",
    "jsqr": "^1.4.0",
    "jszip": "^3.10.1",
    "moment": "^2.30.1",
    "pdfjs-dist": "^6.2.108",
    "pinia": "^3.0.2",
    "qr-code-styling": "^1.9.2",
    "quill": "^2.0.2",
    "sass": "^1.80.5",
    "standard-version": "^9.5.0",
    "typescript": "^7.0.2",
    "uuid": "^11.1.0",
    "vite": "^6.3.5",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-jsonx": "^1.1.2",
    "vite-plugin-require-transform": "^1.0.21",
    "vite-plugin-transform__require-to-import": "^1.1.6",
    "vue": "^3.4.21",
    "vue-devtools": "^5.1.4",
    "vue-echarts": "^7.0.3",
    "vue-router": "^4.4.5",
    "vue-tsc": "^2.0.6",
    "vue3-draggable-resizable": "^1.6.5"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "adm-zip": "^0.6.0",
    "chardet": "^2.2.0",
    "electron-log": "^5.4.3",
    "font-list": "^2.0.1",
    "iconv-lite": "^0.7.3",
    "pdf-lib": "^1.17.1",
    "puppeteer": "^24.26.1",
